FROM node:24-alpine AS frontend
WORKDIR /site
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python:3.13-slim
WORKDIR /app
COPY requirements.txt requirements-web.txt ./
RUN pip install --no-cache-dir -r requirements-web.txt && useradd --create-home vault
COPY vault.py security_analytics.py web_api.py ./
COPY --from=frontend /site/dist ./web/dist
RUN mkdir -p /app/data && chown -R vault:vault /app/data
USER vault
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/status')"
CMD ["python", "-m", "uvicorn", "web_api:app", "--host", "0.0.0.0", "--port", "8000"]

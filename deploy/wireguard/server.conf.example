# /etc/wireguard/wg0.conf -- replace placeholders, chmod 600, never commit keys.
# Install WireGuard with your operating system's official package manager.
[Interface]
Address = 10.8.0.1/24
ListenPort = 51820
PrivateKey = REPLACE_WITH_SERVER_PRIVATE_KEY

[Peer]
PublicKey = REPLACE_WITH_CLIENT_PUBLIC_KEY
AllowedIPs = 10.8.0.2/32
